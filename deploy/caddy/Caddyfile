# koko behind Caddy — automatic HTTPS, WebSocket passthrough.
#
#   sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

koko.example.com {
	encode zstd gzip

	# The chat WebSocket — Caddy proxies WS upgrades automatically.
	reverse_proxy 127.0.0.1:8080

	header {
		# Tighten the browser surface for the web client.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# healthz is intentionally public; everything else needs a token.
	}
}
